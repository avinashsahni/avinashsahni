---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import ContactCTA from '../../components/sections/ContactCTA.astro';
import { projectsData, type ProjectItem } from '../../data/projects';
import { siteConfig } from '../../data/siteConfig';
import { generateBreadcrumbSchema } from '../../lib/seo';

export function getStaticPaths() {
  return projectsData.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;

const pageTitle = `${project.title} – Case Study | ${siteConfig.name}`;
const pageDescription = project.shortDescription;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Projects', url: '/projects' },
  { name: project.title, url: `/projects/${project.slug}` },
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={breadcrumbSchema}
>
  <article class="py-16 sm:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-mono text-text-muted">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/projects" class="hover:text-white transition-colors">Projects</a>
        <span>/</span>
        <span class="text-accent">{project.title}</span>
      </nav>

      <!-- Case Study Header -->
      <div class="mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full border border-white/10 bg-[#141414] text-xs font-mono text-accent uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse" />
          Technical Case Study
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">
          {project.title}
        </h1>
        <p class="mt-4 text-lg text-text-secondary leading-relaxed">
          {project.shortDescription}
        </p>

        <!-- Project Meta Strip -->
        <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4 p-5 rounded-xl border border-white/10 bg-[#121212] font-mono text-xs">
          <div>
            <span class="text-text-muted block text-[10px] uppercase">Category</span>
            <span class="text-white font-medium mt-0.5 block">{project.category}</span>
          </div>
          <div>
            <span class="text-text-muted block text-[10px] uppercase">Role</span>
            <span class="text-white font-medium mt-0.5 block">{project.role}</span>
          </div>
          <div>
            <span class="text-text-muted block text-[10px] uppercase">Status</span>
            <span class="text-emerald-400 font-medium mt-0.5 block">{project.status}</span>
          </div>
          <div>
            <span class="text-text-muted block text-[10px] uppercase">Deployment</span>
            <span class="text-accent font-medium mt-0.5 block">Edge / Cloud</span>
          </div>
        </div>

        <!-- Action Links -->
        <div class="mt-6 flex flex-wrap gap-4">
          {project.liveUrl && (
            <a
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-accent text-white text-xs font-semibold hover:bg-accent-hover transition-colors shadow-[0_0_20px_rgba(255,107,53,0.25)]"
            >
              <span>Visit Live Application</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" stroke-linecap="round" stroke-linejoin="round"/>
                <polyline points="15 3 21 3 21 9" stroke-linecap="round" stroke-linejoin="round"/>
                <line x1="10" x2="21" y1="14" y2="3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          )}

          {project.githubUrl && (
            <a
              href={project.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-white/10 bg-[#141414] text-white text-xs font-medium hover:border-white/20 hover:bg-[#1A1A1A] transition-colors"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              <span>Inspect Source Repository</span>
            </a>
          )}
        </div>
      </div>

      <!-- Case Study Body Sections -->
      <div class="space-y-12 border-t border-white/10 pt-10 text-text-secondary leading-relaxed">
        <!-- Overview -->
        <div>
          <h2 class="text-2xl font-bold text-white mb-4">Project Overview</h2>
          <p class="text-base text-text-secondary leading-relaxed">
            {project.fullDescription}
          </p>
        </div>

        <!-- Architectural Blueprint -->
        <div>
          <h2 class="text-2xl font-bold text-white mb-4">Architectural Blueprint & Design Decisions</h2>
          <div class="p-6 rounded-xl border border-white/10 bg-[#121212] space-y-4">
            <p class="text-sm text-text-secondary leading-relaxed">
              {project.architectureNotes}
            </p>
            <div class="pt-4 border-t border-white/5 flex flex-wrap gap-2">
              {project.technologies.map((tech) => (
                <span class="text-xs font-mono text-accent bg-accent/10 border border-accent/20 px-3 py-1 rounded-md">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Key Functionality -->
        <div>
          <h2 class="text-2xl font-bold text-white mb-6">Engineered Functionality</h2>
          <div class="space-y-3">
            {project.keyFunctionality.map((func, index) => (
              <div class="p-4 rounded-lg border border-white/10 bg-[#141414] flex items-start gap-3">
                <span class="text-xs font-mono text-accent mt-0.5 font-bold">0{index + 1}</span>
                <span class="text-sm text-white">{func}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Summary & Next Steps -->
        <div class="p-8 rounded-xl border border-accent/30 bg-[#121212] flex flex-col sm:flex-row items-center justify-between gap-6">
          <div class="space-y-1 text-center sm:text-left">
            <h3 class="text-lg font-bold text-white">Need a similar architecture built for your product?</h3>
            <p class="text-xs sm:text-sm text-text-secondary">
              Let's talk through your technical specifications, timeline, and deployment needs.
            </p>
          </div>
          <Button href="/contact" variant="primary" size="md">
            Discuss Your Architecture
          </Button>
        </div>
      </div>
    </div>
  </article>

  <ContactCTA />
</BaseLayout>

