---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import ContactCTA from '../../components/sections/ContactCTA.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/utils';
import { siteConfig } from '../../data/siteConfig';
import { generateBreadcrumbSchema } from '../../lib/seo';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const pageTitle = `Engineering Insights & Articles – ${siteConfig.name}`;
const pageDescription =
  'Technical essays, architecture guides, and pragmatic perspectives on Node.js, SaaS development, React, Next.js, and web systems.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog' },
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={breadcrumbSchema}
>
  <div class="py-16 sm:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-mono text-text-muted">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-accent">Blog</span>
      </nav>

      <!-- Header -->
      <div class="mb-14">
        <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full border border-white/10 bg-[#141414] text-xs font-mono text-accent uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse" />
          Engineering Writing
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Technical Articles & Architecture Notes
        </h1>
        <p class="mt-4 text-base sm:text-lg text-text-secondary leading-relaxed">
          Pragmatic essays on building scalable SaaS platforms, choosing modern frontend architectures, and securing Node.js REST services.
        </p>
      </div>

      <!-- Article List -->
      <div class="space-y-6">
        {sortedPosts.map((post) => (
          <article class="group relative rounded-xl border border-white/10 bg-[#111111] p-6 sm:p-8 transition-all duration-300 hover:border-accent/40 hover:bg-[#141414] hover:shadow-[0_8px_30px_rgba(0,0,0,0.5)]">
            <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-text-muted mb-3">
              <span class="text-accent font-semibold">{post.data.category}</span>
              <span>•</span>
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              {post.data.isDraft && (
                <span class="px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[10px]">
                  Draft Review
                </span>
              )}
            </div>

            <h2 class="text-xl sm:text-2xl font-bold text-white group-hover:text-accent transition-colors">
              <a href={`/blog/${post.slug}`}>
                <span class="absolute inset-0" aria-hidden="true" />
                {post.data.title}
              </a>
            </h2>

            <p class="mt-3 text-sm text-text-secondary leading-relaxed">
              {post.data.description}
            </p>

            <div class="mt-6 pt-5 border-t border-white/5 flex flex-wrap items-center justify-between gap-4">
              <div class="flex flex-wrap gap-1.5">
                {post.data.tags.map((tag) => (
                  <span class="text-[11px] font-mono text-text-muted bg-white/[0.04] px-2 py-0.5 rounded">
                    #{tag}
                  </span>
                ))}
              </div>

              <span class="inline-flex items-center gap-1 text-xs font-medium text-accent group-hover:translate-x-1 transition-transform">
                Read Article
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <ContactCTA />
</BaseLayout>

