---
import Button from '../ui/Button.astro';
import { siteConfig } from '../../data/siteConfig';
---

<section class="py-20 sm:py-28 relative overflow-hidden">
  <!-- Glowing border container -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-2xl border border-accent/30 bg-gradient-to-b from-[#161616] via-[#111111] to-[#0A0A0A] p-8 sm:p-14 lg:p-16 text-center shadow-[0_0_50px_rgba(255,107,53,0.12)] overflow-hidden">
      <!-- Glow ambient background effect -->
      <div
        class="pointer-events-none absolute -top-32 left-1/2 -translate-x-1/2 w-96 h-96 bg-accent/20 rounded-full blur-3xl -z-10"
        aria-hidden="true"
      ></div>

      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 mb-6 rounded-full border border-white/10 bg-[#161616] text-xs font-mono text-emerald-400">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>{siteConfig.availability}</span>
      </div>

      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight max-w-2xl mx-auto text-balance">
        Have an idea? Let's build something great.
      </h2>

      <p class="mt-4 text-base sm:text-lg text-text-secondary max-w-xl mx-auto leading-relaxed">
        Tell me about your project, your goals and the challenges you're trying to solve.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <Button href="/contact" variant="primary" size="lg">
          <span>Start a Conversation</span>
          <svg class="w-4 h-4 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </Button>

        <Button href={`mailto:${siteConfig.email}`} variant="secondary" size="lg">
          <span>Email Directly</span>
        </Button>
      </div>

      <p class="mt-6 text-xs font-mono text-text-muted">
        Typically responding within 24 hours • Non-disclosure agreements respected
      </p>
    </div>
  </div>
</section>

