---
import Button from '../ui/Button.astro';
import { siteConfig } from '../../data/siteConfig';
---

<section class="relative pt-20 pb-20 md:pt-28 md:pb-28 overflow-hidden">
  <!-- Subtle radial ambient background glow -->
  <div
    class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[450px] bg-gradient-to-b from-accent/15 via-accent/5 to-transparent blur-3xl -z-10"
    aria-hidden="true"
  ></div>

  <!-- Subtle background grid -->
  <div class="pointer-events-none absolute inset-0 subtle-dot-grid opacity-30 -z-20" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left Hero Column: Value Proposition -->
      <div class="lg:col-span-7 space-y-8 text-left">
        <!-- Availability Badge -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-white/10 bg-[#141414] text-xs font-mono text-emerald-400">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>{siteConfig.availability}</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.1] text-balance">
          {siteConfig.tagline}
        </h1>

        <!-- Supporting Text -->
        <p class="text-lg sm:text-xl text-text-secondary leading-relaxed max-w-2xl text-pretty font-normal">
          {siteConfig.description}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <Button href="/contact" variant="primary" size="lg">
            <span>Let's Discuss Your Project</span>
            <svg class="w-4 h-4 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </Button>

          <Button href="/projects" variant="secondary" size="lg">
            <span>Explore My Work</span>
          </Button>
        </div>

        <!-- Trust Badges -->
        <div class="pt-6 border-t border-white/10 flex flex-wrap items-center gap-6 text-xs font-mono text-text-muted">
          <div class="flex items-center gap-2">
            <span class="text-white font-semibold">6+ Years</span>
            <span>Node.js Backend</span>
          </div>
          <span class="text-white/20">•</span>
          <div class="flex items-center gap-2">
            <span class="text-white font-semibold">Full-Lifecycle</span>
            <span>Architecture to Deploy</span>
          </div>
          <span class="text-white/20">•</span>
          <div class="flex items-center gap-2">
            <span class="text-accent font-semibold">Direct Access</span>
            <span>Zero Agency Bloat</span>
          </div>
        </div>
      </div>

      <!-- Right Hero Column: Developer Themed Interactive Visual -->
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-md lg:max-w-none rounded-xl border border-white/10 bg-[#111111] shadow-[0_20px_50px_rgba(0,0,0,0.8),0_0_30px_rgba(255,107,53,0.1)] overflow-hidden">
          <!-- Terminal Title Bar -->
          <div class="h-10 bg-[#161616] border-b border-white/10 px-4 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#FF5F56]/80" />
              <span class="w-3 h-3 rounded-full bg-[#FFBD2E]/80" />
              <span class="w-3 h-3 rounded-full bg-[#27C93F]/80" />
            </div>
            <div class="text-[11px] font-mono text-text-muted flex items-center gap-1.5">
              <span class="text-accent">●</span>
              <span>avinash-stack.ts</span>
            </div>
            <span class="text-[10px] font-mono text-text-muted px-1.5 py-0.5 rounded bg-white/5">
              Node v22
            </span>
          </div>

          <!-- Code Payload -->
          <div class="p-5 font-mono text-xs leading-relaxed text-text-secondary bg-[#0D0D0D] overflow-x-auto">
            <p class="text-text-muted">// Engineering scalable digital systems</p>
            <p class="mt-2">
              <span class="text-[#FF7B72]">const</span> <span class="text-[#79C0FF]">engineer</span> = &#123;
            </p>
            <div class="pl-4 space-y-1">
              <p>
                <span class="text-[#7EE787]">name</span>: <span class="text-[#A5D6FF]">'Avinash Sahni'</span>,
              </p>
              <p>
                <span class="text-[#7EE787]">title</span>: <span class="text-[#A5D6FF]">'Full-Stack Developer'</span>,
              </p>
              <p>
                <span class="text-[#7EE787]">experience</span>: <span class="text-[#FFA657]">'6+ years Node.js'</span>,
              </p>
              <p>
                <span class="text-[#7EE787]">focus</span>: [
              </p>
              <div class="pl-4 text-[#A5D6FF] space-y-0.5">
                <p>'SaaS Platforms',</p>
                <p>'High-Performance APIs',</p>
                <p>'Clean Architecture'</p>
              </div>
              <p>],</p>
              <p>
                <span class="text-[#7EE787]">primaryStack</span>: &#123;
              </p>
              <div class="pl-4 space-y-0.5 text-text-muted">
                <p><span class="text-[#79C0FF]">frontend</span>: <span class="text-[#A5D6FF]">['React', 'Next.js', 'Astro']</span>,</p>
                <p><span class="text-[#79C0FF]">backend</span>: <span class="text-[#A5D6FF]">['Node.js', 'TypeScript', 'REST']</span>,</p>
                <p><span class="text-[#79C0FF]">database</span>: <span class="text-[#A5D6FF]">['PostgreSQL', 'Prisma', 'MongoDB']</span></p>
              </div>
              <p>&#125;,</p>
              <p>
                <span class="text-[#7EE787]">availableForHire</span>: <span class="text-[#79C0FF]">true</span>
              </p>
            </div>
            <p>&#125;;</p>

            <!-- Execution Result Box -->
            <div class="mt-4 pt-3 border-t border-white/10 text-[11px] text-emerald-400 flex items-center justify-between">
              <span class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" />
                Status: Ready for project scoping
              </span>
              <a href="/contact" class="text-accent hover:underline text-[11px]">
                Inquire &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

