---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
---

<section class="py-20 sm:py-28 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Engineering Philosophy"
      title="Disciplined Engineering for Long-Term Scalability"
      description="I believe great digital products are built on solid fundamentals: clean abstractions, performant databases, and reliable backend architectures that evolve with your business."
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Editorial Overview -->
      <div class="lg:col-span-7 space-y-6 text-text-secondary leading-relaxed">
        <p class="text-base sm:text-lg text-white font-medium">
          Hello, I'm <span class="text-accent">Avinash Sahni</span> — an independent Full-Stack Developer partnering directly with startups, entrepreneurs, and growing businesses worldwide.
        </p>

        <p>
          With 6+ years of experience specializing in the Node.js and modern JavaScript ecosystem, I have developed a straightforward approach to software engineering: eliminate unnecessary complexity, prioritize system reliability, and write maintainable code that your future team can effortlessly extend.
        </p>

        <p>
          Unlike bloated development agencies with layers of account managers, I provide direct technical collaboration. From initial database schema modeling and API contract design through to responsive user interfaces and production deployment, I handle the full product engineering lifecycle.
        </p>

        <div class="pt-4 flex flex-wrap gap-4">
          <Button href="/about" variant="secondary" size="md">
            <span>Read Full Developer Story</span>
            <svg class="w-4 h-4 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </Button>

          <Button href="/contact" variant="ghost" size="md">
            <span>Discuss a Project &rarr;</span>
          </Button>
        </div>
      </div>

      <!-- Right Structural Capabilities Cards -->
      <div class="lg:col-span-5 space-y-3.5">
        {[
          {
            title: 'Frontend Engineering',
            desc: 'Responsive, accessible interfaces built with React, Next.js, and Astro with sub-second performance.',
          },
          {
            title: 'Backend Architecture',
            desc: '6+ years Node.js experience building microservices, resilient event listeners, and clean API gateways.',
          },
          {
            title: 'API & Microservices Development',
            desc: 'Structured, typed REST endpoints with authentication, rate-limiting, and automated documentation.',
          },
          {
            title: 'Database Design & Optimization',
            desc: 'Relational modeling with PostgreSQL & MySQL, indexing strategies, and Prisma ORM migrations.',
          },
          {
            title: 'End-to-End Application Delivery',
            desc: 'Full-cycle implementation: planning, building, CI/CD automated deployment, and ongoing technical support.',
          },
        ].map((item, idx) => (
          <div class="p-4 rounded-lg border border-white/10 bg-[#121212] hover:border-accent/40 transition-colors">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs font-mono text-accent font-semibold">0{idx + 1}</span>
              <h3 class="text-sm font-bold text-white">{item.title}</h3>
            </div>
            <p class="text-xs text-text-secondary pl-6 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
