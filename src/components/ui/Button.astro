---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  target?: string;
  rel?: string;
  id?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  class: className = '',
  type = 'button',
  target,
  rel,
  id,
  ...rest
} = Astro.props;

const baseStyles =
  'inline-flex items-center justify-center font-medium rounded-lg transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:scale-[0.98] select-none';

const variants = {
  primary:
    'bg-[#FF6B35] text-white hover:bg-[#FF8252] shadow-[0_0_20px_rgba(255,107,53,0.3)] hover:shadow-[0_0_28px_rgba(255,107,53,0.45)] border border-[#FF8252]/40',
  secondary:
    'bg-[#141414] text-text-primary hover:bg-[#1E1E1E] border border-white/10 hover:border-white/20 hover:text-white',
  outline:
    'bg-transparent text-text-primary hover:text-white border border-white/15 hover:border-accent hover:bg-accent/5',
  ghost:
    'bg-transparent text-text-secondary hover:text-white hover:bg-white/5',
};

const sizes = {
  sm: 'text-xs px-3 py-1.5 gap-1.5',
  md: 'text-sm px-4 py-2.5 gap-2',
  lg: 'text-base px-6 py-3.5 gap-2.5 font-semibold',
};

const classes = `${baseStyles} ${variants[variant]} ${sizes[size]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel} id={id} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} id={id} {...rest}>
      <slot />
    </button>
  )
}

