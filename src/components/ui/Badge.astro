---
interface Props {
  variant?: 'default' | 'accent' | 'success' | 'outline';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  variant = 'default',
  size = 'md',
  class: className = '',
} = Astro.props;

const baseStyles =
  'inline-flex items-center font-mono font-medium rounded-full transition-colors border select-none';

const variants = {
  default: 'bg-[#181818] text-text-secondary border-white/10 hover:border-white/20',
  accent: 'bg-[#FF6B35]/10 text-[#FFA27B] border-[#FF6B35]/30',
  success: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  outline: 'bg-transparent text-text-muted border-white/10',
};

const sizes = {
  sm: 'text-xs px-2.5 py-0.5 gap-1.5',
  md: 'text-xs px-3 py-1 gap-2',
};

const classes = `${baseStyles} ${variants[variant]} ${sizes[size]} ${className}`;
---

<span class={classes}>
  <slot />
</span>

